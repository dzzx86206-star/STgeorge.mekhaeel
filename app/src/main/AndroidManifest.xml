<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".utils.STgeorgeApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.STgeorge"
        android:networkSecurityConfig="@xml/network_security_config">

        <activity
            android:name=".activities.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.STgeorge.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".activities.LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".activities.RegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".activities.ForgotPasswordActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".activities.MainActivity"
            android:exported="false" />

        <activity
            android:name=".activities.AnnouncementsListActivity"
            android:exported="false" />

        <activity
            android:name=".activities.SettingsActivity"
            android:exported="false" />

        <activity
            android:name=".activities.ComingSoonActivity"
            android:exported="false" />

        <activity
            android:name=".activities.SundaySchoolHomeActivity"
            android:exported="false" />

        <activity
            android:name=".activities.ClassDetailActivity"
            android:exported="false" />

        <activity
            android:name=".activities.AttendanceActivity"
            android:exported="false" />

        <activity
            android:name=".activities.ChildRecordActivity"
            android:exported="false" />

        <activity
            android:name=".activities.UserManagementActivity"
            android:exported="false" />

        <activity
            android:name=".activities.AgpeyaListActivity"
            android:exported="false"
            android:label="@string/agpeya_title" />

        <activity
            android:name=".activities.AgpeyaDetailActivity"
            android:exported="false" />

        <activity
            android:name=".activities.TafsirHomeActivity"
            android:exported="false"
            android:label="@string/tafsir_title" />

        <activity
            android:name=".activities.BibleBookListActivity"
            android:exported="false" />

        <activity
            android:name=".activities.BibleBookDetailActivity"
            android:exported="false" />

        <service
            android:name=".firebase.STgeorgeFcmService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="@string/default_notification_channel_id" />

    </application>

</manifest>
